  "tokenColors": [
    {
      "name": "plain",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "support",
        "entity",
        "variable",
        "variable.language",
        "variable.parameter",
        "entity.name.type",
        "entity.name.function",
        "support.function",
        "support.type",
        "support.class",
        "meta.function-call",
        "entity.other.attribute-name",
        "entity.name.tag",
        "keyword.operator",
        "meta.attribute",
        "meta.decorator",
        "entity.name.namespace",
        "entity.name.function.decorator",
        "support.variable",
        "constant.other"
      ],
      "settings": {
        "foreground": "#CECDC3",
        "fontStyle": ""
      }
    },
    {
      "name": "comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "string.quoted.docstring",
        "string.quoted.docstring punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#D0A215",
        "fontStyle": ""
      }
    },
    {
      "name": "strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.regexp",
        "constant.other.placeholder",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#3AA99F",
        "fontStyle": ""
      }
    },
    {
      "name": "interpolation",
      "scope": [
        "meta.template.expression",
        "meta.embedded",
        "meta.fstring.python meta.embedded",
        "source.python meta.fstring.python constant.other"
      ],
      "settings": {
        "foreground": "#CECDC3",
        "fontStyle": ""
      }
    },
    {
      "name": "interpolation punct",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "constant.character.format.placeholder.other.python",
        "storage.type.format.python",
        "support.other.format.python"
      ],
      "settings": {
        "foreground": "#6F6E69",
        "fontStyle": ""
      }
    },
    {
      "name": "constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other.symbol",
        "constant.character.escape",
        "variable.other.enummember",
        "support.constant.property-value",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.python"
      ],
      "settings": {
        "foreground": "#DA702C",
        "fontStyle": ""
      }
    },
    {
      "name": "definitions",
      "scope": [
        "meta.function.python entity.name.function",
        "entity.name.type.class.python",
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.trait",
        "entity.name.type.declaration",
        "entity.name.type.type",
        "entity.name.function.definition",
        "meta.function.definition entity.name.function",
        "entity.name.function.preprocessor",
        "entity.name.section",
        "markup.heading",
        "entity.other.attribute-name.table.toml",
        "support.type.property-name.table.toml"
      ],
      "settings": {
        "foreground": "#CE73A2",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "keyword.operator.namespace",
        "keyword.operator.access",
        "punctuation.definition.tag",
        "punctuation.section",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#6F6E69",
        "fontStyle": ""
      }
    },
    {
      "name": "cell marker",
      "scope": [
        "markup.heading.cell.alabaster"
      ],
      "settings": {
        "foreground": "#CE73A2",
        "fontStyle": ""
      }
    },
    {
      "name": "cell marker punct",
      "scope": [
        "punctuation.definition.cell.alabaster"
