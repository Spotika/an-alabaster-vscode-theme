      "settings": {
        "foreground": "#DA702C",
        "fontStyle": ""
      }
    },
    {
      "name": "note",
      "scope": [
        "keyword.other.note.alabaster"
      ],
      "settings": {
        "foreground": "#CE73A2",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 1",
      "scope": [
        "rainbow1"
      ],
      "settings": {
        "foreground": "#CECDC3",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 2",
      "scope": [
