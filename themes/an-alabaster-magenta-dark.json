      "settings": {
        "foreground": "#CECDC3",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 8",
      "scope": [
        "entity.name.type.rainbow8"
      ],
      "settings": {
        "foreground": "#CE9CB1",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 9",
      "scope": [
        "markup.bold.rainbow9"
      ],
      "settings": {
        "foreground": "#CECDC3",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 10",
      "scope": [
        "invalid.rainbow10"
      ],
      "settings": {
        "foreground": "#CE9CB1",
        "fontStyle": ""
      }
    },
    {
      "name": "markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#CECDC3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#CECDC3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#D15044",
        "fontStyle": ""
      }
    }
