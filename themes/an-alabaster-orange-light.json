  "tokenColors": [
    {
      "name": "plain",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "support",
        "entity",
        "variable",
        "variable.language",
        "variable.parameter",
        "entity.name.type",
        "entity.name.function",
        "support.function",
        "support.type",
        "support.class",
        "meta.function-call",
        "entity.other.attribute-name",
        "entity.name.tag",
        "keyword.operator",
        "meta.attribute",
        "meta.decorator",
        "entity.name.namespace",
        "entity.name.function.decorator",
        "support.variable",
        "constant.other"
      ],
      "settings": {
        "foreground": "#100F0F",
        "fontStyle": ""
      }
    },
    {
      "name": "comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "string.quoted.docstring",
        "string.quoted.docstring punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#247971",
        "fontStyle": ""
      }
    },
    {
      "name": "strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.regexp",
        "constant.other.placeholder",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#647E0B",
        "fontStyle": ""
      }
    },
    {
      "name": "interpolation",
      "scope": [
        "meta.template.expression",
        "meta.embedded",
        "meta.fstring.python meta.embedded",
        "source.python meta.fstring.python constant.other"
      ],
      "settings": {
        "foreground": "#100F0F",
        "fontStyle": ""
      }
    },
    {
      "name": "interpolation punct",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "constant.character.format.placeholder.other.python",
        "storage.type.format.python",
        "support.other.format.python"
      ],
      "settings": {
        "foreground": "#878580",
        "fontStyle": ""
      }
    },
    {
      "name": "constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other.symbol",
        "constant.character.escape",
        "variable.other.enummember",
        "support.constant.property-value",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.python"
      ],
      "settings": {
        "foreground": "#A02F6F",
        "fontStyle": ""
      }
    },
    {
      "name": "definitions",
      "scope": [
        "meta.function.python entity.name.function",
        "entity.name.type.class.python",
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.trait",
        "entity.name.type.declaration",
        "entity.name.type.type",
        "entity.name.function.definition",
        "meta.function.definition entity.name.function",
        "entity.name.function.preprocessor",
        "entity.name.section",
        "markup.heading",
        "entity.other.attribute-name.table.toml",
        "support.type.property-name.table.toml"
      ],
      "settings": {
        "foreground": "#A74B15",
        "fontStyle": ""
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "keyword.operator.namespace",
        "keyword.operator.access",
        "punctuation.definition.tag",
        "punctuation.section",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#878580",
        "fontStyle": ""
      }
    },
    {
      "name": "cell marker",
      "scope": [
        "markup.heading.cell.alabaster"
      ],
      "settings": {
        "foreground": "#A74B15",
        "fontStyle": ""
      }
    },
    {
      "name": "cell marker punct",
      "scope": [
        "punctuation.definition.cell.alabaster"
      ],
      "settings": {
        "foreground": "#878580",
        "fontStyle": ""
      }
    },
    {
      "name": "todo",
      "scope": [
        "keyword.other.todo.alabaster"
      ],
      "settings": {
        "foreground": "#8F6F01",
        "fontStyle": ""
      }
    },
    {
      "name": "note",
      "scope": [
        "keyword.other.note.alabaster"
      ],
      "settings": {
        "foreground": "#A74B15",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 1",
      "scope": [
        "rainbow1"
      ],
      "settings": {
        "foreground": "#100F0F",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 2",
      "scope": [
        "keyword.rainbow2"
      ],
      "settings": {
        "foreground": "#633012",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 3",
      "scope": [
        "entity.name.function.rainbow3"
      ],
      "settings": {
        "foreground": "#100F0F",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 4",
      "scope": [
        "comment.rainbow4"
      ],
      "settings": {
        "foreground": "#633012",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 5",
      "scope": [
        "string.rainbow5"
      ],
      "settings": {
        "foreground": "#100F0F",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 6",
      "scope": [
        "variable.parameter.rainbow6"
      ],
      "settings": {
        "foreground": "#633012",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 7",
      "scope": [
        "constant.numeric.rainbow7"
      ],
      "settings": {
        "foreground": "#100F0F",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 8",
      "scope": [
        "entity.name.type.rainbow8"
      ],
      "settings": {
        "foreground": "#633012",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 9",
      "scope": [
        "markup.bold.rainbow9"
      ],
      "settings": {
        "foreground": "#100F0F",
        "fontStyle": ""
      }
    },
    {
      "name": "csv column 10",
      "scope": [
        "invalid.rainbow10"
      ],
      "settings": {
        "foreground": "#633012",
        "fontStyle": ""
      }
    },
    {
      "name": "markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#100F0F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#100F0F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#AF3029",
        "fontStyle": ""
      }
    }
  ],
